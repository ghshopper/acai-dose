Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Apple Wallet calls /wallet/v1/... with an Authorization header
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^wallet/(.*)$ api/wallet.php?p=$1 [QSA,L]
# Short link to the staff app download: order.acaiee.com/app
RewriteRule ^app/?$ https://github.com/ghshopper/acai-dose/releases/download/app-latest/acai-dose-staff.apk [R=302,L]
RewriteRule ^orders/?$ https://github.com/ghshopper/acai-dose/releases/download/orders-latest/acai-dose-orders.apk [R=302,L]
# Karak Dose: same site under /karak/ (its own tables; the API knows from the address)
# Always /karak/ with the slash, so the page's links stay under Karak Dose
RewriteRule ^karak$ /karak/ [R=301,L]
RewriteRule ^karak/$ karak.html [L]
RewriteRule ^karak/app/?$ https://github.com/ghshopper/acai-dose/releases/download/karak-latest/karak-dose-staff.apk [R=302,L]
RewriteRule ^karak/api/(api|setup)\.php$ api/$1.php [QSA,L]
RewriteRule ^karak/(pos|screen|dashboard)(\.html)?/?$ $1.html [L]
RewriteRule ^karak/(assets/.+)$ $1 [L]
# Short links: /pos -> pos.html, /screen -> screen.html, /dashboard -> dashboard.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Source and project files are not part of the website
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(android|staff_app|owner_app|orders_app|tools|\.github|\.git)(/|$)
# Always check for a fresh copy so updates reach the shop devices straight away.
<IfModule mod_headers.c>
<FilesMatch "\.(html|js|css)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
