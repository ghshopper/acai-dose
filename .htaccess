Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Apple Wallet calls /wallet/v1/... with an Authorization header
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^wallet/(.*)$ api/wallet.php?p=$1 [QSA,L]
# Short links: /pos -> pos.html, /screen -> screen.html, /dashboard -> dashboard.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Source and project files are not part of the website
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(android|staff_app|tools|\.github|\.git)(/|$)
# Always check for a fresh copy so updates reach the shop devices straight away.
<IfModule mod_headers.c>
<FilesMatch "\.(html|js|css)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
